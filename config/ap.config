# ============================================================
# 京东云百里 (RE-CP-03) 纯 AP 精简配置片段
# 追加在 defconfig/mt7986-ax6000.config 之后, 由 make defconfig 归一化
# 说明: 若某个包是别的包的硬依赖, kconfig 会自动把它拉回来, 不会报错
# ============================================================

# ---- 目标平台 ----
# 这里刻意不写任何 CONFIG_TARGET_* 行。
# 它们属于 kconfig 的 choice(单选)项, 在文件末尾重复赋值会触发
# "override ... changes choice state", 把上游 defconfig 里已经选好的
# 子目标和设备全部重置, 结果就是设备没被选中。
# 上游 defconfig 已包含 jdcloud_re-cp-03=y, 交给它即可。

# ---- 编译加速 ----
CONFIG_CCACHE=y

# ---- LuCI 基础 (上游模板里缺了这层, 显式补上, 保证有完整后台) ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y

# ---- Fluent 主题 (默认主题, 支持中文) ----
# 源码来自 LazuliKao/luci-theme-fluent, 由 CI clone 后拷入 package/ 再编译。
# 首次开机默认启用由 files/etc/uci-defaults/99-ap-mode 里的第 7 节完成。
CONFIG_PACKAGE_luci-theme-fluent=y

# ============================================================
# 一、剔除: 纯 AP 用不到的功能插件
# ============================================================

# 代理客户端: AP 只做二层转发, 不参与路由, 这类插件完全无用, 且带一堆依赖
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Client is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Server is not set

# 流量统计面板: 统计的是网桥透传流量, 对 AP 没有参考价值, 还常驻一个采集进程
# CONFIG_PACKAGE_luci-app-wrtbwmon is not set

# MTK 硬件 QoS: 作用于 WAN 上行整形, AP 没有 WAN, 开了也不生效
# CONFIG_PACKAGE_luci-app-eqos-mtk is not set

# 磁盘/内存相关: 百里没有 USB 口, 1GB 内存跑 AP 也用不到 swap
# CONFIG_PACKAGE_automount is not set
# CONFIG_PACKAGE_zram-swap is not set

# 容器 / NAS / 下载器 (若你换过 base, 这些可能被带进来, 这里兜底关掉)
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_containerd is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_samba4-server is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_transmission-daemon is not set
# CONFIG_PACKAGE_qbittorrent is not set
# CONFIG_PACKAGE_aria2 is not set

# ============================================================
# 二、保留并补充: AP 验收与排障必需的小工具
# ============================================================
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_mtr=y

# 说明: 以下这些上游默认已开, 不做改动, 是无线性能的关键
#   CONFIG_MTK_WARP_V2=y               -> WED 无线硬件加速, 4x4 满速不掉包的关键
#   CONFIG_MTK_FAST_NAT_SUPPORT=y      -> HNAT 有线硬件 NAT
#   CONFIG_MTK_WHNAT_SUPPORT=m         -> 无线侧 NAT 卸载
#   CONFIG_MTK_DOT11K_RRM_SUPPORT=y    -> 802.11k 邻居报告
#   CONFIG_MTK_DOT11R_FT_SUPPORT=y     -> 802.11r 快速漫游（注意: 闭源驱动下漫游靠 MTK 自己实现, DAWN 用不了）
#   CONFIG_MTK_DOT11W_PMF_SUPPORT=y    -> 802.11w 管理帧保护
#   CONFIG_MTK_BAND_STEERING=y         -> 2.4G/5G 引导
#   CONFIG_PACKAGE_kmod-mediatek_hnat=y
#   CONFIG_PACKAGE_kmod-tcp-bbr=y      -> BBR 拥塞控制

# ============================================================
# 三、只编译百里一台设备
# ============================================================
# 上游 defconfig (chasey-dev 25.12 的 mt7986-ax6000.config) 默认勾了
# 25 台设备。MULTI_PROFILE + PER_DEVICE_ROOTFS 模式下每台设备都要
# 单独编一次内核和独立 rootfs, 必须全部关掉只留 jdcloud_re-cp-03。
# 注意: DEVICE_* 符号虽属 choice 成员, 但 is not set 行是 kconfig
# 标准关闭写法, 在 padavanonly 分支已验证不会触发 choice 重置。
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_acelink_ew-7886cax is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_acer_predator-w6d is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_acer_predator-w6x-stock is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_acer_predator-w6x-ubootmod is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_smartrg_sdg-8612 is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_smartrg_sdg-8614 is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_asus_tuf-ax6000 is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_bananapi_bpi-r3 is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_clx_s20m is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_clx_s20p is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_dlink_aquila-pro-ai-m60-a1 is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_glinet_gl-mt6000 is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_netcore_n60-pro-mtkuboot is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_netcore_n60-pro is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_ruijie_rg-x60-pro is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_tplink_archer-ax80-v1 is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_tplink_tl-xdr6086 is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_tplink_tl-xdr6088 is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_wavlink_wl-wn536ax6-a is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-ubootmod is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-stock is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-mtkuboot is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_zyxel_ex5601-t0-ubootmod is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_zyxel_ex5601-t0-stock is not set

# turboacc 的 flow-offload 与 HNAT 会争抢同一条加速路径, 同时开反而掉速。
# HNAT/WED 已经在驱动层做好, 这个插件直接不装, 避免误开。
# CONFIG_PACKAGE_luci-app-turboacc-mtk is not set

# ============================================================
# 四、后台中文化
# ============================================================
# 上游 defconfig 只带了 MTK 无线页的中文, 其余菜单是英文。
# 这三个是 LuCI 基础/防火墙/软件包页的翻译, 合计几百 KB。
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# zram-swap 已经关掉, 单独留着 kmod-zram 没有任何用处
# CONFIG_PACKAGE_kmod-zram is not set
